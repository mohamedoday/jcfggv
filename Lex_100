def banner():
    os.system('clear')
    print(f"""
{Fore.CYAN}╔══════════════════════════════════════════════════════════╗
║        {Fore.WHITE}LEX-OSINT 100+ | ULTRA-FAST LINUX ENGINE{Fore.CYAN}          ║
║          {Fore.GREEN}Scanning 100+ Platforms Concurrently{Fore.CYAN}            ║
╚══════════════════════════════════════════════════════════╝{Style.RESET_ALL}
    """)

async def check_platform(session, name, url_template, username, found_list, semaphore):
    async with semaphore:
        url = url_template.format(username)
        try:
            async with session.get(url, headers=HEADERS, timeout=7, allow_redirects=True) as response:
                text = await response.text()
                
                # التحقق الذكي من وجود الحساب وعدم الاعتماد فقط على الرمز 200
                is_found = False
                if response.status == 200:
                    false_indicators = [
                        "page not found", "not found", "doesn't exist", 
                        "404", "sorry", "no profile", "user not found"
                    ]
                    if not any(ind in text.lower() for ind in false_indicators):
                        is_found = True

                if is_found:
                    print(f"{Fore.GREEN}[+] {name:<18} : {Fore.WHITE}{url}")
                    found_list.append(f"{name}: {url}")
                else:
                    print(f"{Fore.RED}[-] {name:<18} : Not Found")
        except Exception:
            # تجاهل أخطاء المهلة والاتصال لتسريع العملية وعدم توقف الأداة
            pass

async def main():
    banner()
    username = input(f"{Fore.YELLOW}أدخل اسم المستخدم (Username) المراد بحثه في 100+ منصة: {Fore.WHITE}").strip()
    if not username:
        print(f"{Fore.RED}يرجى إدخال اسم مستخدم صحيح!{Style.RESET_ALL}")
        return

    print(f"\n{Fore.CYAN}[*] جاري فحص {len(PLATFORMS)} منصة وموقع بشكل متزامن وسريع جداً...\n{Style.RESET_ALL}")
    
    found_list = []
    # ضبط عدد الاتصالات المتزامنة (Concurrency Limit) لسرعة قصوى دون حظر الشبكة
    semaphore = asyncio.Semaphore(40)
    
    connector = aiohttp.TCPConnector(limit=50, ssl=False)
    async with aiohttp.ClientSession(connector=connector) as session:
        tasks = [
            check_platform(session, name, url_temp, username, found_list, semaphore)
            for name, url_temp in PLATFORMS.items()
        ]
        await asyncio.gather(*tasks)

    print(f"\n{Fore.CYAN}══════════════════════════════════════════════════════════")
    print(f"{Fore.GREEN}[✓] انتهى الفحص! إجمالي الحسابات المكتشفة: {len(found_list)}")
    
    if found_list:
        filename = f"{username}_lex100_results.txt"
        with open(filename, "w", encoding="utf-8") as f:
            for item in found_list:
                f.write(item + "\n")
        print(f"{Fore.CYAN}[*] تم حفظ النتائج بنجاح في ملف: {Fore.WHITE}{filename}")
    print(f"{Fore.CYAN}══════════════════════════════════════════════════════════{Style.RESET_ALL}\n")

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print(f"\n{Fore.RED}[!] تم إيقاف العملية بواسطة المستخدم.{Style.RESET_ALL}")
        sys.exit(0)
